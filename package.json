{
  "name": "inkleaf",
  "version": "0.3.0",
  "description": "墨页 · Inkleaf — a quiet place to read and write Markdown",
  "main": "out/main.js",
  "author": "wangyuan",
  "homepage": "https://github.com/Fovercon/Inkleaf",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node esbuild.mjs && electron .",
    "test:ui": "node esbuild.mjs && MDR_TEST=1 electron .",
    "package": "node scripts/make-icon.mjs && node esbuild.mjs && electron-builder --mac dir --arm64",
    "release:build": "node scripts/make-release.mjs",
    "release:linux": "node scripts/make-linux-release.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test:updates": "node scripts/test-updater.mjs",
    "test:platform": "node scripts/test-platform.mjs",
    "test:platform-ui": "node scripts/test-platform-ui.mjs"
  },
  "build": {
    "appId": "com.fovercon.inkleaf",
    "productName": "Inkleaf",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Viewer"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "role": "Viewer"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/inkleaf-icon.png",
      "executableName": "inkleaf",
      "category": "Office",
      "maintainer": "Fovercon <fovercon@users.noreply.github.com>",
      "artifactName": "Inkleaf-${version}-linux-${arch}.${ext}",
      "mimeTypes": ["text/markdown", "text/x-markdown"],
      "desktop": {
        "Name": "墨页 · Inkleaf",
        "Comment": "A quiet place to read and write Markdown",
        "StartupWMClass": "Inkleaf"
      }
    },
    "appImage": {
      "executableArgs": ["--ozone-platform-hint=auto"]
    },
    "deb": {
      "afterInstall": "scripts/linux-after-install.sh",
      "afterRemove": "scripts/linux-after-remove.sh",
      "depends": ["libgtk-3-0", "libnss3", "libxss1", "libxtst6", "libatspi2.0-0", "libuuid1", "libgbm1", "libasound2 | libasound2t64", "xdg-utils"]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDisplayName": "墨页 · Inkleaf"
      }
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/yauzl": "^3.4.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/state": "^6.4.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.1",
    "@vscode/markdown-it-katex": "^1.1.1",
    "chokidar": "^3.6.0",
    "codemirror": "^6.0.1",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1",
    "yauzl": "^3.4.0"
  }
}
