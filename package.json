{
  "name": "my-markdown-reader",
  "version": "0.1.0",
  "description": "Personal Markdown reader & editor for macOS",
  "main": "out/main.js",
  "author": "wangyuan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node esbuild.mjs && electron .",
    "test:ui": "node esbuild.mjs && MDR_TEST=1 electron .",
    "package": "node esbuild.mjs && electron-builder --mac dir --arm64"
  },
  "build": {
    "appId": "com.wangyuan.markdown-reader",
    "productName": "Markdown Reader",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ]
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/state": "^6.4.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.1",
    "@vscode/markdown-it-katex": "^1.1.1",
    "chokidar": "^3.6.0",
    "codemirror": "^6.0.1",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1"
  }
}
